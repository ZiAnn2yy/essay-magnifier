# 依赖与构建产物
node_modules/
dist/
*.log

# 本地环境变量：含 API Key，绝不提交、绝不进镜像
.env
.env.local
.env.*.local
# 变体一起挡住：备份、按环境拆分的都算。只放行 .env.example（值是空的）
# 今天差点把 .env.kimi.bak 连 Key 一起提交，补这条规则堵住。
.env.*
!.env.example

# 运行时数据库（schema 由代码创建，不入库）
server/data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# 系统杂项
.DS_Store
Thumbs.db

# 部署暂存
.publish/

# oil-ui skill 的工作目录：方向探索与验证截图，可重新生成，不入库
.oil-ui/
