# ===== 模型 API 配置 =====
# 在 JoyCode 平台获取，OpenAI 兼容协议。填好保存即可，不要把这个文件提交进 git。
# 留空时服务能正常启动，/api/health 可用，/api/chat 会返回降级话术。
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== 服务配置 =====
PORT=3000
NODE_ENV=development

# ===== 模型调用参数 =====
# 单次调用超时（毫秒）。这是**兜底值**：拆解和读者回应都自己覆盖成 90 秒
# （见 src/agent/analyze.js 与 src/agent/reader.js 里的实测分布注释）。
# 60000 是地板不是目标——实测单次调用中位数约 31 秒、长尾 60 秒以上，
# 填小了只会让调用被冤杀、孩子收到兜底话术。
# 部署到魔搭时建议显式填这一项，别依赖默认值。
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
# 思考强度。low = 让它少想，实测同一个拆解任务快约 25%（45.9/49.3s → 36.1/32.3s）。
# 留空 = 不传这个参数，换不接受它的模型时用。
LLM_REASONING_EFFORT=low
# 单次对话最大工具调用轮数，防止死循环
AGENT_MAX_TURNS=8
# 对话输入上限（字）
MAX_INPUT_LENGTH=500
# 范文正文上限（字）。与对话上限分开：一次拆解吃的是一整篇
MAX_ESSAY_LENGTH=2000

# ===== 访问门槛 =====
# 设了就要求输入这个密码才能用（页面和 API 一起挡）。
# **值只放这里，不要写进代码**——提交历史属于作品内容，删不掉。
# 留空 = 不设门槛。本地开发和录演示视频建议留空，深链 ?grade=4 可直接进入；
# 部署给评审专家时填上，并把密码原样写进大赛提交信息的账号密码栏。
# 用一个和任何个人信息无关的值（不是姓名缩写、不是生日）。
ACCESS_CODE=
