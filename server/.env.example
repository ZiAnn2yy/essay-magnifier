# ===== 模型 API 配置 =====
# 在 JoyCode 平台获取，OpenAI 兼容协议。填好保存即可，不要把这个文件提交进 git。
# 留空时服务能正常启动，/api/health 可用，/api/chat 会返回降级话术。
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== 服务配置 =====
PORT=3000
NODE_ENV=development

# ===== 模型调用参数 =====
# 单次调用超时（毫秒）；失败最多重试 2 次
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
# 单次对话最大工具调用轮数，防止死循环
AGENT_MAX_TURNS=8
